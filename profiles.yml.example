# Copiar a profiles.yml, en esta misma carpeta (ya gitignorado). No
# contiene secretos: las credenciales se leen de las mismas variables de
# entorno que ya usa conexion_bd.py en los otros repos del portfolio
# (ver .env.example en esta carpeta). Requiere el paquete `dbt-sqlserver`
# instalado en el mismo entorno WSL donde corre Airflow.
#
# Como profiles.yml vive acá y no en ~/.dbt/, hay que decirle a dbt
# dónde buscarlo -- ver README.md ("Setup local") para el comando
# completo (DBT_PROFILES_DIR + cargar .env antes de correr dbt).

dbt_ahorrazo:
  target: dev
  outputs:

    # Target de desarrollo: schema aislado, para iterar sin tocar las
    # tablas de producción que hoy consumen los 3 proyectos + Power BI.
    dev:
      type: sqlserver
      driver: 'ODBC Driver 17 for SQL Server'
      server: "{{ env_var('DB_SERVER') }}"
      database: "{{ env_var('DB_DATABASE') }}"
      schema: dbt_dev
      user: "{{ env_var('DB_USER') }}"
      password: "{{ env_var('DB_PASSWORD') }}"
      port: 1433
      threads: 4
      # El server usa certificado autofirmado (no emitido por una CA
      # reconocida) -- sin esto, dbt-sqlserver falla el handshake TLS
      # ("certificate chain was issued by an authority that is not
      # trusted"). trust_cert sigue encriptando el tráfico, solo deja de
      # exigir que el certificado esté firmado por una CA. conexion_bd.py
      # no se topa con esto porque su cadena de conexión no fuerza
      # encriptación explícita -- dbt-sqlserver sí, por default.
      trust_cert: true

    # Target de producción: NO usar hasta pasar la Fase 6 (validación en
    # paralelo) de cada proyecto y tener el cutover aprobado.
    prod:
      type: sqlserver
      driver: 'ODBC Driver 17 for SQL Server'
      server: "{{ env_var('DB_SERVER') }}"
      database: "{{ env_var('DB_DATABASE') }}"
      schema: dbo
      user: "{{ env_var('DB_USER') }}"
      password: "{{ env_var('DB_PASSWORD') }}"
      port: 1433
      threads: 4
      # El server usa certificado autofirmado (no emitido por una CA
      # reconocida) -- sin esto, dbt-sqlserver falla el handshake TLS
      # ("certificate chain was issued by an authority that is not
      # trusted"). trust_cert sigue encriptando el tráfico, solo deja de
      # exigir que el certificado esté firmado por una CA. conexion_bd.py
      # no se topa con esto porque su cadena de conexión no fuerza
      # encriptación explícita -- dbt-sqlserver sí, por default.
      trust_cert: true
