# Copiar a .env, en esta misma carpeta (ya gitignorado). Mismos nombres
# de variable que ya usa conexion_bd.py en los otros repos del portfolio
# -- no se inventan nombres nuevos por repo.
#
# No basta con crear el archivo: dbt no carga .env automáticamente (a
# diferencia de conexion_bd.py, que sí usa python-dotenv). Antes de
# correr cualquier comando dbt hay que cargarlo a la sesión de shell --
# ver README.md ("Setup local") para el comando completo.

DB_SERVER=ip_o_host_del_server
DB_DATABASE=nombre_de_la_base
DB_USER=usuario
DB_PASSWORD=password
